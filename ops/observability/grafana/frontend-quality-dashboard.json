{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (status_code) (rate(park_plaza_http_requests_total{status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "title": "API error rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(park_plaza_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "API p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, metric) (rate(park_plaza_client_web_vitals_bucket[15m])))",
          "legendFormat": "{{metric}}",
          "refId": "A"
        }
      ],
      "title": "Client Web Vitals p75 (LCP/INP ms, CLS unitless)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(park_plaza_client_retries_total[5m])",
          "legendFormat": "client retries",
          "refId": "A"
        },
        {
          "expr": "rate(park_plaza_client_events_total{kind=\"websocket\",outcome=\"error\"}[5m])",
          "legendFormat": "WebSocket errors",
          "refId": "B"
        }
      ],
      "title": "Client recovery signals",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "park_plaza_outbox_dead_letter",
          "legendFormat": "dead-letter events",
          "refId": "A"
        },
        {
          "expr": "park_plaza_outbox_pending",
          "legendFormat": "pending events",
          "refId": "B"
        }
      ],
      "title": "Operational backlog",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "park_plaza_realtime_connections",
          "legendFormat": "authenticated connections",
          "refId": "A"
        }
      ],
      "title": "Realtime connections",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["park-plaza", "frontend-quality"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Park Plaza Frontend Quality",
  "uid": "park-plaza-frontend-quality",
  "version": 1
}
