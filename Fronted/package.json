{
  "name": "prototipo-park-plaza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "metrics:bundle": "node scripts/report-bundle.mjs",
    "lint": "oxlint",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test --project=authenticated"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.83.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.18"
  }
}
